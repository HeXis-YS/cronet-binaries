From d69431f04cb96f21fcc1fa3f3053ea0e39f738a3 Mon Sep 17 00:00:00 2001
From: klzgrad <kizdiv@gmail.com>
Date: Sun, 10 Dec 2023 19:05:40 +0800
Subject: [PATCH] build: Support native Cronet without Java targets

---
Only Android imports cronet_test, which packages Java test dependencies. Use
the ordinary test template without Java, and guard URL Java targets with the
same enable_java_templates switch used by the Android build rules.

diff --git a/src/url/BUILD.gn b/src/url/BUILD.gn
index c1f4a88ea..5c69d7666 100644
--- a/src/url/BUILD.gn
+++ b/src/url/BUILD.gn
@@ -74,7 +74,9 @@ component("url") {
   configs += [ "//build/config/compiler:wexit_time_destructors" ]
 
   if (is_android || is_robolectric) {
-    public_deps += [ ":url_jni_headers" ]
+    if (enable_java_templates) {
+      public_deps += [ ":url_jni_headers" ]
+    }
     if (!is_cronet_build) {
       sources += [
         "android/gurl_android.cc",
@@ -127,7 +129,7 @@ component("url") {
   }
 }
 
-if (is_android || is_robolectric) {
+if ((is_android || is_robolectric) && enable_java_templates) {
   generate_jni("url_jni_headers") {
     sources = [ "android/java/src/org/chromium/url/IDNStringUtil.java" ]
     if (!is_cronet_build) {
@@ -140,7 +142,8 @@ if (is_android || is_robolectric) {
     }
   }
 }
-if (is_android && current_toolchain == default_toolchain) {
+if (is_android && enable_java_templates &&
+    current_toolchain == default_toolchain) {
   # TODO(agrieve): Remove alias once usages are removed.
   java_group("gurl_java") {
     deps = [ ":url_java" ]
diff --git a/src/net/BUILD.gn b/src/net/BUILD.gn
--- a/src/net/BUILD.gn
+++ b/src/net/BUILD.gn
@@ -2868,7 +2868,7 @@
   }
 }
 
-if (is_cronet_build) {
+if (is_cronet_build && is_android && enable_java_templates) {
   _test_target_type = "cronet_test"
 } else {
   _test_target_type = "test"
-- 
2.53.0

