From da2e4505e6f115105b6dc0edcf930e17b99486f8 Mon Sep 17 00:00:00 2001
From: klzgrad <kizdiv@gmail.com>
Date: Sun, 6 Oct 2024 14:46:16 +0800
Subject: [PATCH] build: Never explicitly link clang_rt.builtins

https://chromium-review.googlesource.com/c/chromium/src/+/5723176
---
 src/build/config/clang/BUILD.gn | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/build/config/clang/BUILD.gn b/src/build/config/clang/BUILD.gn
index b99148a53..fd51cab9d 100644
--- a/src/build/config/clang/BUILD.gn
+++ b/src/build/config/clang/BUILD.gn
@@ -257,7 +257,10 @@ template("clang_lib") {
 
 # Adds a dependency on the Clang runtime library clang_rt.builtins.
 clang_lib("compiler_builtins") {
-  if (is_mac) {
+  if (true) {
+    # NaiveProxy doesn't use Rust and never links clang_rt.builtins.
+    # Don't define libname which makes this target do nothing.
+  } else if (is_mac) {
     libname = "osx"
   } else if (is_ios) {
     if (target_platform == "iphoneos") {
-- 
2.53.0

