+          .manufacturer = property("ro.product.manufacturer"),
+          .model = property("ro.product.model"),
+          .sdkInt = sdk,
+          .sdkIntFull = sdk * 100000,
+          .securityPatch = property("ro.build.version.security_patch"),
+          .socManufacturer = property("ro.soc.manufacturer"),
+          .versionIncremental = property("ro.build.version.incremental")};
