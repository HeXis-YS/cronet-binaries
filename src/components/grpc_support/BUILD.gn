source_set("headers") {
  public = [
    "include/bidirectional_stream_c.h",
    "include/xray_engine.h",
  ]
}

source_set("grpc_support") {
  sources = [
    "bidirectional_stream.cc",
    "bidirectional_stream.h",
    "bidirectional_stream_c.cc",
    "include/bidirectional_stream_c.h",
    "include/xray_engine.h",
    "xray_engine.cc",
  ]

  deps = [
    ":headers",
    "//base",
    "//net",
    "//url",
  ]
}

shared_library("cronet") {
  output_name = "cronet"
  deps = [ ":grpc_support" ]
}
