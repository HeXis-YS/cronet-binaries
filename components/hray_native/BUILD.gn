source_set("headers") {
  public = [
    "include/hray_stream.h",
    "include/hray_engine.h",
  ]
}

source_set("native") {
  sources = [
    "stream.cc",
    "include/hray_stream.h",
    "include/hray_engine.h",
    "engine.cc",
  ]

  deps = [
    ":headers",
    "//base",
    "//net",
    "//url",
  ]
}

shared_library("cronet") {
  output_name = "cronet"
  deps = [ ":native" ]
  if (is_android) {
    sources = [ "android_tls_visibility.S" ]
  }
  # Keep production LTO optimization local to our final link target.
  configs -= [ "//build/config/compiler:thinlto_optimize_default" ]
  configs += [ "//build/config/compiler:thinlto_optimize_max" ]
  if (is_linux || is_android) {
    inputs = [ "exports.map" ]
    ldflags = [ "-Wl,--version-script=" +
                rebase_path("exports.map", root_build_dir) ]
  }
}
